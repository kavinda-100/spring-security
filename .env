SERVER_PORT=8080

# Database configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/spring_security
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JPA configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Session configuration
SESSION_TIMEOUT=30m

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# CSRF Session configuration
COOKIE_HTTP_ONLY=true# Set to true to prevent JavaScript access to cookies
COOKIE_SECURE=false# Set to true if using HTTPS
COOKIE_SAME_SITE=Lax# Options: Lax, Strict, None

# Admin user configuration
SUPER_ADMIN_EMAIL=kavinda@example.com

# Logging configuration
LOG_FILE=logs/spring-security.log